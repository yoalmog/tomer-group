<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.ActivityDetailPage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Image with Back Button Overlay -->
            <Grid HeightRequest="240">
                <Image Source="{Binding HeaderImage}" Aspect="AspectFill" HeightRequest="240" />
                <BoxView Color="#4D000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                <!-- Back Button -->
                <Button Text="← חזרה למסלול"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="#CC0A0A0C"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="38"
                        FontSize="12"
                        FontAttributes="Bold"
                        Padding="14,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="16,16,16,0" />

                <!-- Bottom Title on Photo -->
                <VerticalStackLayout VerticalOptions="End" Margin="20" Spacing="4">
                    <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" HorizontalOptions="Start">
                        <Label Text="חוויה מאושרת" TextColor="White" FontSize="11" FontAttributes="Bold" />
                    </Border>
                    <Label Text="{Binding ActivityTitle}" FontSize="24" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
            </Grid>

            <!-- Detail Sections Content -->
            <VerticalStackLayout Spacing="16" Padding="18,20,18,32">

                <!-- Time & Location Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⏰ שעת התחלה" FontSize="12" TextColor="#64748B" FontAttributes="Bold" />
                            <Label Text="{Binding StartTime}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Duration, StringFormat='משך משוער: {0}'}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📍 מיקום" FontSize="12" TextColor="#64748B" FontAttributes="Bold" />
                            <Label Text="{Binding Location}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" MaxLines="2" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Guide & Driver Assigned Info -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White"
                        IsVisible="{Binding GuideName, Converter={StaticResource StringNotEmptyConverter}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border BackgroundColor="#F0FDF4" StrokeShape="RoundRectangle 14" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="מדריך מוסמך מטעם Tomer Group" FontSize="11" TextColor="#166534" FontAttributes="Bold" />
                            <Label Text="{Binding GuideName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Meeting Point & Instructions -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="נקודת מפגש ואיסוף" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="{Binding MeetingPoint}" FontSize="13" TextColor="#475569" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Description -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="תיאור הפעילות" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="{Binding Description}" FontSize="13" TextColor="#475569" LineHeight="1.4" />
                    </VerticalStackLayout>
                </Border>

                <!-- What to bring -->
                <Border BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🎒 מה להביא איתך?" FontSize="14" FontAttributes="Bold" TextColor="#92400E" />
                        <Label Text="{Binding WhatToBring}" FontSize="12" TextColor="#78350F" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Altitude Notes -->
                <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🏔️ דגשי גובה ובריאות" FontSize="14" FontAttributes="Bold" TextColor="#1E40AF" />
                        <Label Text="{Binding AltitudeNotes}" FontSize="12" TextColor="#1E3A8A" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Support Hotline Action -->
                <Button Text="שאלה על הפעילות? דברו איתנו בוואטסאפ 💬"
                        Command="{Binding ContactSupportCommand}"
                        Style="{StaticResource BrandButtonStyle}"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

