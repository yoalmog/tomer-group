<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.MorePage"
             Title="עוד ואפשרויות"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Agency Contacts Card -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tomer Group — Peru Travel Experience" FontSize="17" FontAttributes="Bold" TextColor="White" />
                    <Label Text="משרד קוסקו: Portal de Panes 123, Plaza de Armas" FontSize="13" TextColor="#B0C4DE" />
                    <Label Text="{Binding AgencyWhatsApp, StringFormat='וואטסאפ משרד: {0}'}" FontSize="13" TextColor="#B0C4DE" />
                    <Border BackgroundColor="#EF4444" StrokeShape="RoundRectangle 6" Padding="8,4" HorizontalOptions="Start">
                        <Label Text="{Binding EmergencyPhone, StringFormat='🚨 קו חירום 24/7: {0}'}" FontSize="13" TextColor="White" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Chabad Cusco & Shabbat Info -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="✡️ בית חב״ד קוסקו (Chabad House Cusco)" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding ChabadAddress}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding ChabadPhone, StringFormat='טלפון: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="סעודות שבת, תפילות, שיעורים ומסעדה כשרה למהדרין." FontSize="12" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Offline Sync Status & Trigger -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔄 סנכרון נתונים לאופליין" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="סנכרן את כל השוברים, כרטיסי הרכבת ופרטי המדריכים לפני יציאה לאזורים ללא קליטה." FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Button Text="סנכרן נתונים עכשיו" Command="{Binding TriggerOfflineSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="40" />
                    <Label Text="{Binding SyncStatusMessage}" TextColor="{StaticResource StatusSuccess}" FontSize="12" FontAttributes="Bold"
                           IsVisible="{Binding SyncStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Language Switching -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🌐 שפת הממשק (Language)" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="עברית (RTL)" Command="{Binding ChangeLanguageCommand}" CommandParameter="he"
                                Style="{StaticResource PrimaryButtonStyle}" HeightRequest="36" FontSize="12" />
                        <Button Grid.Column="1" Text="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                                BackgroundColor="{StaticResource PrimaryLight}" TextColor="White" HeightRequest="36" FontSize="12" CornerRadius="8" />
                        <Button Grid.Column="2" Text="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"
                                BackgroundColor="{StaticResource PrimaryLight}" TextColor="White" HeightRequest="36" FontSize="12" CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sign Out -->
            <Button Text="התנתק מהחשבון 🚪" Command="{Binding SignOutCommand}" BackgroundColor="#EF4444" TextColor="White"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="46" Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
