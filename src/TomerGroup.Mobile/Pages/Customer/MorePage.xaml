<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
              x:Class="TomerGroup.Mobile.Pages.Customer.MorePage"
              Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Agency Contacts Hero Card -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tomer Group • Peru Travel Experience" FontSize="17" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding OfficeLocationLabel}" FontSize="12" TextColor="#CBD5E1" />
                    <Label Text="{Binding AgencyWhatsApp, StringFormat='WhatsApp: {0}'}" FontSize="13" TextColor="{StaticResource SecondaryLight}" FontAttributes="Bold" />
                    
                    <Button Text="{Binding WhatsAppButtonText}"
                            Command="{Binding OpenAgencyWhatsAppCommand}"
                            BackgroundColor="#25D366"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="42"
                            CornerRadius="8"
                            FontSize="13" />

                    <Border BackgroundColor="#EF4444" StrokeShape="RoundRectangle 6" Padding="10,6" HorizontalOptions="Fill">
                        <Label Text="{Binding EmergencyPhone, StringFormat='🚨 24/7: {0}'}" FontSize="13" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Chabad Cusco & Shabbat Info -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ChabadSectionTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding ChabadAddress}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}" />
                    <Label Text="{Binding ChabadPhone, StringFormat='Tel: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                    <Label Text="{Binding ChabadDescription}" FontSize="12" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Offline Sync Status & Trigger -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding OfflineSyncTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding OfflineSyncDescription}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                    <Button Text="{Binding OfflineSyncButtonText}" Command="{Binding TriggerOfflineSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="42" />
                    <Label Text="{Binding SyncStatusMessage}" TextColor="{StaticResource StatusSuccess}" FontSize="12" FontAttributes="Bold"
                           IsVisible="{Binding SyncStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Language Switching -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LanguageSectionTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="עברית" Command="{Binding ChangeLanguageCommand}" CommandParameter="he"
                                BackgroundColor="{Binding HebrewButtonBg}" TextColor="{Binding HebrewButtonText}"
                                FontAttributes="{Binding HebrewFontWeight}" HeightRequest="38" FontSize="12" CornerRadius="10" />
                        <Button Grid.Column="1" Text="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                                BackgroundColor="{Binding EnglishButtonBg}" TextColor="{Binding EnglishButtonText}"
                                FontAttributes="{Binding EnglishFontWeight}" HeightRequest="38" FontSize="12" CornerRadius="10" />
                        <Button Grid.Column="2" Text="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"
                                BackgroundColor="{Binding SpanishButtonBg}" TextColor="{Binding SpanishButtonText}"
                                FontAttributes="{Binding SpanishFontWeight}" HeightRequest="38" FontSize="12" CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sign In (Unauthenticated) -->
            <Button Text="{Binding SignInButtonText}"
                    Command="{Binding OpenSignInCommand}"
                    IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource BrandButtonStyle}"
                    HeightRequest="46"
                    Margin="0,8,0,16" />

            <!-- Sign Out (Authenticated) -->
            <Button Text="{Binding SignOutButtonText}"
                    Command="{Binding SignOutCommand}"
                    IsVisible="{Binding IsAuthenticated}"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="46"
                    Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
