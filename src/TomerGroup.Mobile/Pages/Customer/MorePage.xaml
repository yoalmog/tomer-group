<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
              x:Class="TomerGroup.Mobile.Pages.Customer.MorePage"
              Title="עוד ואפשרויות">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Agency Contacts Hero Card -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tomer Group • Peru Travel Experience" FontSize="17" FontAttributes="Bold" TextColor="White" />
                    <Label Text="משרד קוסקו: Portal de Panes 123, Plaza de Armas" FontSize="12" TextColor="#CBD5E1" />
                    <Label Text="{Binding AgencyWhatsApp, StringFormat='וואטסאפ: {0}'}" FontSize="13" TextColor="{StaticResource SecondaryLight}" FontAttributes="Bold" />
                    
                    <Button Text="פתח שיחת WhatsApp עם הסוכנות 💬"
                            Command="{Binding OpenAgencyWhatsAppCommand}"
                            BackgroundColor="#25D366"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="42"
                            CornerRadius="8"
                            FontSize="13" />

                    <Border BackgroundColor="#EF4444" StrokeShape="RoundRectangle 6" Padding="10,6" HorizontalOptions="Fill">
                        <Label Text="{Binding EmergencyPhone, StringFormat='🚨 קו חירום 24/7: {0}'}" FontSize="13" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Chabad Cusco & Shabbat Info -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="✡️ בית חב״ד קוסקו (Chabad House Cusco)" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding ChabadAddress}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=White}" />
                    <Label Text="{Binding ChabadPhone, StringFormat='טלפון: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                    <Label Text="סעודות שבת, תפילות, שיעורים ומסעדה כשרה למהדרין." FontSize="12" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Offline Sync Status & Trigger -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔄 סנכרון נתונים לאופליין" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="סנכרן את כל השוברים, כרטיסי הרכבת ופרטי המדריכים לפני יציאה לאזורים ללא קליטה בהרי האנדים." FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                    <Button Text="סנכרן נתונים עכשיו" Command="{Binding TriggerOfflineSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="42" />
                    <Label Text="{Binding SyncStatusMessage}" TextColor="{StaticResource StatusSuccess}" FontSize="12" FontAttributes="Bold"
                           IsVisible="{Binding SyncStatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Language Switching -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🌐 שפת הממשק (Language)" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="עברית" Command="{Binding ChangeLanguageCommand}" CommandParameter="he"
                                Style="{StaticResource PrimaryButtonStyle}" HeightRequest="38" FontSize="12" />
                        <Button Grid.Column="1" Text="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                                BackgroundColor="#E2E8F0" TextColor="#0F172A" HeightRequest="38" FontSize="12" CornerRadius="10" />
                        <Button Grid.Column="2" Text="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"
                                BackgroundColor="#E2E8F0" TextColor="#0F172A" HeightRequest="38" FontSize="12" CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sign Out -->
            <Button Text="התנתק מהחשבון 🚪" Command="{Binding SignOutCommand}" BackgroundColor="#EF4444" TextColor="White"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="46" Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
