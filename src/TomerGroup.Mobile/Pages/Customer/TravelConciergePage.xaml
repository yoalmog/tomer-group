<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TomerGroup.Mobile.Pages.Customer.TravelConciergePage"
             Title="Travel concierge">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Personal concierge" FontSize="12" FontAttributes="Bold" TextColor="#FDE68A"/>
                    <Label Text="{Binding AssistantName}" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="#E2E8F0"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dedicated support" Style="{StaticResource SectionTitleStyle}"/>

                    <CollectionView ItemsSource="{Binding Services}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Margin="0,0,0,10" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#475569"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
