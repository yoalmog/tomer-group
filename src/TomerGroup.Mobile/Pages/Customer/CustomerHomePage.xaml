<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
             x:Class="TomerGroup.Mobile.Pages.Customer.CustomerHomePage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="16,12,16,36">

            <!-- ============================================================ -->
            <!-- 1. TOP BRAND HEADER: LOGO + TITLE + LANGUAGE + WHATSAPP      -->
            <!-- ============================================================ -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border StrokeThickness="0" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="44" HeightRequest="44" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding CustomerGreeting}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                    <Label Text="Tomer Group • Peru Travel Experience" FontSize="11" TextColor="#64748B" FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Language Switcher & Direct WhatsApp Action (No Sign-In required) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                    <Button Text="עב"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="he"
                            BackgroundColor="{Binding HebrewButtonBg}"
                            TextColor="{Binding HebrewButtonText}"
                            FontAttributes="{Binding HebrewFontWeight}"
                            HeightRequest="30"
                            WidthRequest="34"
                            FontSize="10"
                            CornerRadius="8"
                            Padding="0" />

                    <Button Text="EN"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="en"
                            BackgroundColor="{Binding EnglishButtonBg}"
                            TextColor="{Binding EnglishButtonText}"
                            FontAttributes="{Binding EnglishFontWeight}"
                            HeightRequest="30"
                            WidthRequest="34"
                            FontSize="10"
                            CornerRadius="8"
                            Padding="0" />

                    <Border BackgroundColor="#25D366"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            WidthRequest="34"
                            HeightRequest="34"
                            VerticalOptions="Center">
                        <Label Text="💬" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWhatsAppCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ============================================================ -->
            <!-- 2. HERO BANNER: CINEMATIC PERU PHOTO & PUBLIC EXPLORE        -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource TravelCardStyle}">
                <Grid HeightRequest="260">
                    <Image Source="{Binding HeroImageUrl}" Aspect="AspectFill" HeightRequest="260" />
                    <BoxView Color="#4D000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                    <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="Start" Margin="16">
                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                            <Label Text="PERU TRAVEL EXPERIENCE" TextColor="White" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Authenticated Hero Content (if user signed in) -->
                    <VerticalStackLayout VerticalOptions="End" Margin="16" Spacing="8" IsVisible="{Binding HasActiveTrip}">
                        <Label Text="{Binding TripTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding TripDates}" FontSize="13" TextColor="#F1F5F9" />
                        <Label Text="{Binding TripDestinationsSummary}" FontSize="12" TextColor="#CBD5E1" />

                        <Button Text="{Binding ViewFullItineraryButtonText}"
                                Command="{Binding OpenMyTripCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="22"
                                HeightRequest="44"
                                FontSize="13"
                                FontAttributes="Bold"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- Public / Open Catalog Hero Content -->
                    <VerticalStackLayout VerticalOptions="End" Margin="16" Spacing="8" IsVisible="{Binding HasActiveTrip, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="{Binding HeroTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap" />
                        <Label Text="{Binding HeroSubtitle}" FontSize="12" TextColor="#F1F5F9" LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Text="{Binding DiscoverTreksButtonText}"
                                    Command="{Binding OpenTreksCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    CornerRadius="22"
                                    HeightRequest="44"
                                    FontSize="13"
                                    FontAttributes="Bold" />

                            <Button Grid.Column="1"
                                    Text="{Binding ContactWhatsAppButtonText}"
                                    Command="{Binding OpenWhatsAppCommand}"
                                    BackgroundColor="#25D366"
                                    TextColor="White"
                                    CornerRadius="22"
                                    HeightRequest="44"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="14,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 3. QUICK BROWSE CATEGORIES (9 CORE AREAS)                    -->
            <!-- ============================================================ -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <!-- Treks -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏔️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryTreksLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTreksCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Destinations -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏛️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryDestinationsLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Tours -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🚌" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryToursLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenToursCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Services -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🛎️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryServicesLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Hotels -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏨" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryHotelsLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHotelsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Activities -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🧗" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryActivitiesLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenActivitiesCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- My Trip -->
                    <Border BackgroundColor="{StaticResource TomerRoseTint}" Stroke="#FEE2E2" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🗺️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryMyTripLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMyTripCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- About Tomer Group -->
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="ℹ️" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategoryAboutLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSupportCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Support -->
                    <Border BackgroundColor="#F0FDF4" Stroke="#DCFCE7" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="💬" FontSize="16" VerticalOptions="Center" />
                            <Label Text="{Binding CategorySupportLabel}" FontSize="12" FontAttributes="Bold" TextColor="#166534" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWhatsAppCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============================================================ -->
            <!-- 4. FEATURED TREKS (IMMEDIATE PUBLIC BROWSING & MAP)          -->
            <!-- ============================================================ -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding FeaturedTreksTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding ViewAllButtonText}" Command="{Binding OpenTreksCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" Padding="0" />
            </Grid>

            <CollectionView ItemsSource="{Binding FeaturedTreks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TravelCardStyle}" Margin="0,0,0,14">
                            <VerticalStackLayout Spacing="0">
                                <Grid HeightRequest="160">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="160" />
                                    <BoxView Color="#3D000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                    <!-- Altitude & Duration Badges -->
                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Spacing="6">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3">
                                            <Label Text="{Binding Elevation}" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <Border BackgroundColor="#DD0A0A0C" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3">
                                            <Label Text="{Binding Duration}" TextColor="White" FontSize="10" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Trek Title on Image -->
                                    <VerticalStackLayout VerticalOptions="End" Margin="14" Spacing="2">
                                        <Label Text="{Binding DisplayTitle}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Difficulty}" FontSize="11" TextColor="#E2E8F0" />
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout Padding="14" Spacing="8">
                                    <Label Text="{Binding DisplaySummary}" FontSize="12" TextColor="#475569" LineHeight="1.3" />

                                    <!-- Interactive Trek Map Action -->
                                    <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=ViewInteractiveMapText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenTrekMapCommand}"
                                            CommandParameter="{Binding RouteName}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            CornerRadius="18"
                                            HeightRequest="38"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ============================================================ -->
            <!-- 5. ICONIC DESTINATIONS CAROUSEL                              -->
            <!-- ============================================================ -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding FlagshipDestinationsTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding ViewAllButtonText}" Command="{Binding OpenExploreCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" Padding="0" />
            </Grid>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="14">
                    <!-- Cusco Card -->
                    <Border Style="{StaticResource TravelCardStyle}" WidthRequest="210">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="130">
                                <Image Source="{Binding CuscoImage}" Aspect="AspectFill" HeightRequest="130" />
                                <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                    <Label Text="3,400m" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Padding="14" Spacing="4">
                                <Label Text="{Binding CuscoName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding CuscoDescription}" FontSize="12" TextColor="#64748B" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Machu Picchu Card -->
                    <Border Style="{StaticResource TravelCardStyle}" WidthRequest="210">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="130">
                                <Image Source="{Binding MachuPicchuImage}" Aspect="AspectFill" HeightRequest="130" />
                                <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                    <Label Text="{Binding WorldWonderBadge}" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Padding="14" Spacing="4">
                                <Label Text="{Binding MachuPicchuName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding MachuPicchuDescription}" FontSize="12" TextColor="#64748B" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Sacred Valley Card -->
                    <Border Style="{StaticResource TravelCardStyle}" WidthRequest="210">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="130">
                                <Image Source="{Binding SacredValleyImage}" Aspect="AspectFill" HeightRequest="130" />
                                <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                    <Label Text="2,870m" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Padding="14" Spacing="4">
                                <Label Text="{Binding SacredValleyName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding SacredValleyDescription}" FontSize="12" TextColor="#64748B" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Lake Titicaca Card -->
                    <Border Style="{StaticResource TravelCardStyle}" WidthRequest="210">
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="130">
                                <Image Source="{Binding LakeTiticacaImage}" Aspect="AspectFill" HeightRequest="130" />
                                <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                    <Label Text="3,812m" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Padding="14" Spacing="4">
                                <Label Text="{Binding LakeTiticacaName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding LakeTiticacaDescription}" FontSize="12" TextColor="#64748B" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============================================================ -->
            <!-- 6. DAY TOURS & EXCURSIONS                                    -->
            <!-- ============================================================ -->
            <Label Text="{Binding FeaturedToursTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="12">
                    <BindableLayout.ItemsSource>
                        <Binding Path="FeaturedTours" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TravelCardStyle}" WidthRequest="240">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="130">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="130" />
                                        <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                        <Border BackgroundColor="#DD0A0A0C" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                            <Label Text="{Binding Duration}" TextColor="White" FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Padding="12" Spacing="4">
                                        <Label Text="{Binding DisplayTitle}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                        <Label Text="{Binding Location}" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        <Label Text="{Binding DisplayDescription}" FontSize="11" TextColor="#64748B" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenToursCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============================================================ -->
            <!-- 7. CURATED ANDEAN HOTELS & LODGES                            -->
            <!-- ============================================================ -->
            <Label Text="{Binding CuratedHotelsTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="12">
                    <BindableLayout.ItemsSource>
                        <Binding Path="CuratedHotels" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TravelCardStyle}" WidthRequest="250">
                                <VerticalStackLayout Spacing="0">
                                    <Grid HeightRequest="130">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="130" />
                                        <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" Margin="10" VerticalOptions="Start" HorizontalOptions="Start">
                                            <Label Text="{Binding FeatureBadge}" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Padding="12" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                        <Label Text="{Binding Location}" FontSize="11" TextColor="#64748B" />
                                        <Label Text="{Binding DisplayDescription}" FontSize="11" TextColor="#475569" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenHotelsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============================================================ -->
            <!-- 8. ADVENTURE & CULTURAL ACTIVITIES                           -->
            <!-- ============================================================ -->
            <Label Text="{Binding AdventureActivitiesTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                <!-- Activity 1 -->
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🧗" FontSize="20" />
                        <Label Text="Zipline &amp; Via Ferrata" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="Sacred Valley • Half Day" FontSize="10" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenActivitiesCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Activity 2 -->
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🏍️" FontSize="20" />
                        <Label Text="ATV Quad Biking" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="Maras &amp; Moray • Half Day" FontSize="10" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenActivitiesCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Activity 3 -->
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🛶" FontSize="20" />
                        <Label Text="Urubamba Rafting" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="Class III-IV • Full Day" FontSize="10" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenActivitiesCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Activity 4 -->
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="👨‍🍳" FontSize="20" />
                        <Label Text="Ceviche &amp; Pisco Class" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                        <Label Text="Cusco Market • 3 Hours" FontSize="10" TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenActivitiesCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- 9. THE TOMER GROUP SERVICE ADVANTAGE                         -->
            <!-- ============================================================ -->
            <Label Text="{Binding ServiceExperienceTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding AcclimatizationTitle}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding AcclimatizationDescription}" FontSize="11" TextColor="#64748B" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding KosherShabbatTitle}" FontSize="13" FontAttributes="Bold" TextColor="#166534" />
                        <Label Text="{Binding KosherShabbatDescription}" FontSize="11" TextColor="#64748B" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding PrivateTransportTitle}" FontSize="13" FontAttributes="Bold" TextColor="#1D4ED8" />
                        <Label Text="{Binding PrivateTransportDescription}" FontSize="11" TextColor="#64748B" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding MultilingualGuidesTitle}" FontSize="13" FontAttributes="Bold" TextColor="#6B21A8" />
                        <Label Text="{Binding MultilingualGuidesDescription}" FontSize="11" TextColor="#64748B" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- 10. ABOUT TOMER GROUP (COMPANY PROFILE & FIELD BASE)         -->
            <!-- ============================================================ -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 22" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border BackgroundColor="{StaticResource TomerRoseTint}" StrokeShape="RoundRectangle 14" StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                            <Label Text="🏔️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center">
                            <Label Text="{Binding AboutUsTitle}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                            <Label Text="Cusco, Peru • Est. 2012" FontSize="11" TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding AboutUsStory}" FontSize="12" TextColor="#475569" LineHeight="1.4" />

                    <!-- Key Badges Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4">
                            <Label Text="{Binding AboutBadgeCusco}" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4">
                            <Label Text="{Binding AboutBadgeDispatch}" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4">
                            <Label Text="{Binding AboutBadgeExperience}" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4">
                            <Label Text="{Binding AboutBadgeSafety}" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================ -->
            <!-- 11. 24/7 FIELD SUPPORT & WHATSAPP HOTLINE                    -->
            <!-- ============================================================ -->
            <Border BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border BackgroundColor="#25D366" StrokeShape="RoundRectangle 18" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Label Text="💬" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding SupportHotlineTitle}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding SupportHotlineSubtitle}" FontSize="11" TextColor="#CBD5E1" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding WhatsAppActionLabel}"
                                Command="{Binding OpenWhatsAppCommand}"
                                BackgroundColor="#25D366"
                                TextColor="White"
                                CornerRadius="18"
                                HeightRequest="40"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button Grid.Column="1"
                                Text="{Binding CallOfficeActionLabel}"
                                Command="{Binding OpenEmergencyCallCommand}"
                                BackgroundColor="#334155"
                                TextColor="White"
                                CornerRadius="18"
                                HeightRequest="40"
                                FontSize="12"
                                FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
