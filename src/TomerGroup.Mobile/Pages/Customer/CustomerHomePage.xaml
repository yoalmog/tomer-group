<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
             x:Class="TomerGroup.Mobile.Pages.Customer.CustomerHomePage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Header: Logo, Customer Name, Notification Badge -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Image Source="splash.png" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center">
                    <Label Text="{Binding CustomerGreeting}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding TripTitle}" FontSize="13" TextColor="{StaticResource TextSecondaryLight}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="🔔" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#E2E8F0" FontSize="18" Padding="0" />
            </Grid>

            <!-- Country & Destination Hero Card -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding CountryBadge}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Border BackgroundColor="{StaticResource Secondary}" Padding="8,2" StrokeShape="RoundRectangle 6">
                            <Label Text="VIP Traveler" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="{Binding CurrentDestination}" FontSize="16" TextColor="{StaticResource SecondaryLight}" FontAttributes="Bold" />
                    <Label Text="{Binding TripDates}" FontSize="13" TextColor="#CBD5E1" />
                </VerticalStackLayout>
            </Border>

            <!-- Next Activity Section -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="הפעילות הבאה:" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

                    <!-- 05:30 איסוף מהמלון -->
                    <Grid ColumnDefinitions="60,*" RowSpacing="4">
                        <Label Text="{Binding NextActivityTime}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding NextActivityTitle}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- 08:30 מאצ'ו פיצ'ו -->
                    <Grid ColumnDefinitions="60,*" RowSpacing="4">
                        <Label Text="{Binding SecondActivityTime}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding SecondActivityTitle}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- 16:00 רכבת חזרה -->
                    <Grid ColumnDefinitions="60,*" RowSpacing="4">
                        <Label Text="{Binding ThirdActivityTime}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ThirdActivityTitle}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Access 4-Buttons Grid (Section 8) -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Text="הטיול שלי" Command="{Binding OpenMyTripCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Row="0" Grid.Column="1" Text="ההזמנות שלי" Command="{Binding OpenBookingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Row="1" Grid.Column="0" Text="המסמכים שלי" Command="{Binding OpenDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Row="1" Grid.Column="1" Text="צור קשר" Command="{Binding ContactAgencyCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!-- Emergency Contact Banner -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="#FEF2F2" Stroke="#FCA5A5">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="🚨" FontSize="26" VerticalOptions="Center" Padding="0,0,10,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="מוקד חירום Tomer Group (24/7)" FontSize="13" FontAttributes="Bold" TextColor="#991B1B" />
                        <Label Text="{Binding EmergencyPhone}" FontSize="15" FontAttributes="Bold" TextColor="#B91C1C" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

