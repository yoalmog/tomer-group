<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
              x:Class="TomerGroup.Mobile.Pages.Customer.CustomerHomePage"
              Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Premium Header: Official Logo, Traveler Greeting, Notifications -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" BackgroundColor="Transparent">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="44" HeightRequest="44" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center">
                    <Label Text="{Binding CustomerGreeting}" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                    <Label Text="Tomer Group • Peru Travel Experience" FontSize="12" TextColor="{StaticResource Secondary}" FontAttributes="Bold" />
                </VerticalStackLayout>
                <Border Grid.Column="2" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" VerticalOptions="Center">
                    <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Active Trip Hero Card (Visible if HasActiveTrip) -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}" IsVisible="{Binding HasActiveTrip}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding CountryBadge}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Border Grid.Column="1" BackgroundColor="{StaticResource BrandMonogram}" Padding="8,3" StrokeShape="RoundRectangle 6">
                            <Label Text="מסע פעיל" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding TripTitle}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding CurrentDestination, StringFormat='יעד: {0}'}" FontSize="14" TextColor="{StaticResource SecondaryLight}" FontAttributes="Bold" />
                    <Label Text="{Binding TripDates}" FontSize="13" TextColor="#CBD5E1" />
                </VerticalStackLayout>
            </Border>

            <!-- Next Activity Section (Visible if HasActiveTrip and HasNextActivity) -->
            <Border Style="{StaticResource CardFrameStyle}" IsVisible="{Binding HasNextActivity}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="⏱️" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Text="הפעילות הבאה במסלול" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="55,*" RowSpacing="4">
                        <Label Text="{Binding NextActivityTime}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding NextActivityTitle}" FontSize="15" FontAttributes="Bold" />
                            <Label Text="{Binding NextActivityLocation}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" IsVisible="{Binding NextActivityLocation, Converter={StaticResource StringNotEmptyConverter}}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Professional Empty State (Visible when HasActiveTrip is False) -->
            <Border Style="{StaticResource EmptyStateCardStyle}" IsVisible="{Binding HasActiveTrip, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="🏔️" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding EmptyTripMessage}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyTripSubtext}" FontSize="13" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button Text="צור קשר עם הסוכנות 💬"
                            Command="{Binding ContactAgencyCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="20,0"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick Access 4-Action Grid -->
            <Label Text="גישה מהירה" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="🗺️ מסלול הטיול" Command="{Binding OpenMyTripCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" />
                <Button Grid.Row="0" Grid.Column="1" Text="📋 ההזמנות שלי" Command="{Binding OpenBookingsCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" />
                <Button Grid.Row="1" Grid.Column="0" Text="🎫 שוברים ומסמכים" Command="{Binding OpenDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="14" />
                <Button Grid.Row="1" Grid.Column="1" Text="ℹ️ עוד וסיוע 24/7" Command="{Binding OpenMoreCommand}" Style="{StaticResource SecondaryButtonStyle}" FontSize="14" />
            </Grid>

            <!-- 24/7 Emergency Hotline Banner -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="#FEF2F2" Stroke="#FECACA">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="🚨" FontSize="26" VerticalOptions="Center" Padding="0,0,10,0" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="מוקד חירום ותמיכה למטיילים (24/7)" FontSize="12" FontAttributes="Bold" TextColor="#991B1B" />
                        <Label Text="{Binding EmergencyPhone}" FontSize="15" FontAttributes="Bold" TextColor="#B91C1C" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
