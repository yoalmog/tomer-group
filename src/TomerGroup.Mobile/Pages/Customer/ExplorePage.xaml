<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.ExplorePage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16,12,16,32">

            <!-- Top Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border StrokeThickness="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="40" HeightRequest="40" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding PageHeaderTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding PageHeaderSubtitle}" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <!-- Region Filter Chips -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding FilterAllText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="הכל"
                            BackgroundColor="{Binding AllFilterBg}"
                            TextColor="{Binding AllFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="{Binding FilterTreksText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="טרקים"
                            BackgroundColor="{Binding TreksFilterBg}"
                            TextColor="{Binding TreksFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="{Binding FilterCuscoText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="קוסקו והעמק הקדוש"
                            BackgroundColor="{Binding CuscoFilterBg}"
                            TextColor="{Binding CuscoFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="{Binding FilterMachuText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="מאצ'ו פיצ'ו"
                            BackgroundColor="{Binding MachuFilterBg}"
                            TextColor="{Binding MachuFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="{Binding FilterAndesText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="הרי האנדים"
                            BackgroundColor="{Binding AndesFilterBg}"
                            TextColor="{Binding AndesFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="{Binding FilterAmazonText}"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="יער האמזונס"
                            BackgroundColor="{Binding AmazonFilterBg}"
                            TextColor="{Binding AmazonFilterText}"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Destination Cards Collection -->
            <CollectionView ItemsSource="{Binding Destinations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TravelCardStyle}" Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="0">
                                <!-- Photo Container with Elevation Pill -->
                                <Grid HeightRequest="210">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="210" />

                                    <!-- Gradient Overlay for readability -->
                                    <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                    <!-- Top Badges -->
                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="14" Spacing="8">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                                            <Label Text="{Binding Elevation}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Border BackgroundColor="#CC0A0A0C" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                                            <Label Text="{Binding RecommendedDays}" TextColor="White" FontSize="11" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Bottom Titles on Photo -->
                                    <VerticalStackLayout VerticalOptions="End" Margin="16" Spacing="2">
                                        <Label Text="{Binding DisplayTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding DisplaySubtitle}" FontSize="13" TextColor="#F1F5F9" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Card Content -->
                                <VerticalStackLayout Padding="16" Spacing="10">
                                    <Label Text="{Binding DisplayTagline}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding DisplayDescription}" FontSize="13" TextColor="#475569" LineHeight="1.3" />

                                    <!-- Highlights Chips -->
                                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4" Margin="0,4,6,0">
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=HighlightsLabel}" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                                        </Border>
                                    </FlexLayout>

                                    <!-- Interactive Trek Map Action -->
                                    <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=TrekMapButtonText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=OpenTrekMapCommand}"
                                            CommandParameter="{Binding Title}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Peru Travel Advisory Tips Section -->
            <Label Text="{Binding TipsSectionTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding TravelTips}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrameStyle}" Margin="0,0,0,10" BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DisplayTitle}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                    <Label Text="{Binding DisplaySubtitle}" FontSize="12" TextColor="#64748B" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Need Help / Contact Card -->
            <Border BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ContactCardTitle}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding ContactCardDescription}"
                           FontSize="13" TextColor="#CBD5E1" LineHeight="1.3" />
                    <Button Text="{Binding ContactCardButtonText}"
                            Command="{Binding ContactTeamCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

