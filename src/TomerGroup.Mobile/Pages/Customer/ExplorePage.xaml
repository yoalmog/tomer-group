<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.ExplorePage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16,12,16,32">

            <!-- Top Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Border StrokeThickness="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="40" HeightRequest="40" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Padding="12,0" VerticalOptions="Center" Spacing="2">
                    <Label Text="גלה את פרו" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="יעדים, טרקים וחוויות בלתי נשכחות" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <!-- Region Filter Chips -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="הכל"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="הכל"
                            BackgroundColor="#0F172A"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Padding="16,0" />

                    <Button Text="קוסקו והעמק הקדוש"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="קוסקו והעמק הקדוש"
                            BackgroundColor="#FFFFFF"
                            TextColor="#334155"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="16,0" />

                    <Button Text="מאצ'ו פיצ'ו"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="מאצ'ו פיצ'ו"
                            BackgroundColor="#FFFFFF"
                            TextColor="#334155"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="16,0" />

                    <Button Text="הרי האנדים"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="הרי האנדים"
                            BackgroundColor="#FFFFFF"
                            TextColor="#334155"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="16,0" />

                    <Button Text="יער האמזונס"
                            Command="{Binding FilterDestinationsCommand}"
                            CommandParameter="יער האמזונס"
                            BackgroundColor="#FFFFFF"
                            TextColor="#334155"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            CornerRadius="20"
                            HeightRequest="38"
                            FontSize="13"
                            Padding="16,0" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Destination Cards Collection -->
            <CollectionView ItemsSource="{Binding Destinations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TravelCardStyle}" Margin="0,0,0,16">
                            <VerticalStackLayout Spacing="0">
                                <!-- Photo Container with Elevation Pill -->
                                <Grid HeightRequest="210">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="210" />

                                    <!-- Gradient Overlay for readability -->
                                    <BoxView Color="#33000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                    <!-- Top Badges -->
                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="14" Spacing="8">
                                        <Border BackgroundColor="#E11D48" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                                            <Label Text="{Binding Elevation}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <Border BackgroundColor="#CC0F172A" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4">
                                            <Label Text="{Binding RecommendedDays}" TextColor="White" FontSize="11" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Bottom Titles on Photo -->
                                    <VerticalStackLayout VerticalOptions="End" Margin="16" Spacing="2">
                                        <Label Text="{Binding HebrewTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Title}" FontSize="13" TextColor="#F1F5F9" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Card Content -->
                                <VerticalStackLayout Padding="16" Spacing="10">
                                    <Label Text="{Binding Tagline}" FontSize="14" FontAttributes="Bold" TextColor="#BE123C" />
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="#475569" LineHeight="1.3" />

                                    <!-- Highlights Chips -->
                                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,4" Margin="0,4,6,0">
                                            <Label Text="✨ חוויות מרכזיות" FontSize="11" TextColor="#334155" FontAttributes="Bold" />
                                        </Border>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Peru Travel Advisory Tips Section -->
            <Label Text="טיפים חיוניים למטייל בפרו" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding TravelTips}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrameStyle}" Margin="0,0,0,10" BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Need Help / Contact Card -->
            <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="מתכננים את הטיול שלכם לפרו?" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="מומחי היעד של Tomer Group ירכיבו עבורכם מסלול אישי מותאם במדויק כולל מלונות, העברות והדרכה בעברית."
                           FontSize="13" TextColor="#CBD5E1" LineHeight="1.3" />
                    <Button Text="דברו עם צוות המומחים שלנו 💬"
                            Command="{Binding ContactTeamCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
