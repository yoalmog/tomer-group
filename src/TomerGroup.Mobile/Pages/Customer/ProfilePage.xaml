<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
              x:Class="TomerGroup.Mobile.Pages.Customer.ProfilePage"
              x:DataType="vm:ProfileViewModel"
              Title="פרופיל מטייל">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Hero Header Card -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <!-- Initials Avatar -->
                    <Border Stroke="{StaticResource BrandMonogram}" StrokeThickness="2" BackgroundColor="{StaticResource PrimaryLight}" StrokeShape="RoundRectangle 36" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center">
                        <Label Text="{Binding Initials}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>

                    <Label Text="{Binding HebrewName}" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" IsVisible="{Binding HebrewName, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding PassportName}" FontSize="13" TextColor="#CBD5E1" HorizontalTextAlignment="Center" IsVisible="{Binding PassportName, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding Email}" FontSize="12" TextColor="{StaticResource SecondaryLight}" HorizontalTextAlignment="Center" IsVisible="{Binding Email, Converter={StaticResource StringNotEmptyConverter}}" />

                    <!-- Edit Mode Toggle Button -->
                    <Button Text="{Binding IsEditing, Converter={x:Null}}"
                            TextTransform="None"
                            Command="{Binding ToggleEditModeCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="38"
                            FontSize="13"
                            FontAttributes="Bold"
                            Margin="0,6,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Text" Value="✕ בטל עריכה" />
                                <Setter Property="BackgroundColor" Value="#64748B" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Text" Value="✎ ערוך פרטים" />
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Status Alert Message -->
            <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 8" Padding="12">
                <Label Text="{Binding StatusMessage}" FontSize="13" FontAttributes="Bold" TextColor="#059669" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Section 1: Personal & Contact Information -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="פרטים אישיים וקשר" Style="{StaticResource SectionTitleStyle}" />

                    <!-- View Mode -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="שם בעברית:" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding HebrewName}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Passport Name:" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PassportName}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="WhatsApp:" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding WhatsApp}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />

                            <Label Grid.Row="3" Grid.Column="0" Text="אימייל:" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Email}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Edit Mode Inputs -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing}">
                        <Label Text="שם בעברית:" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                        <Entry Text="{Binding HebrewName}" Placeholder="שם מלא בעברית" />

                        <Label Text="Passport Name (English):" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                        <Entry Text="{Binding PassportName}" Placeholder="Full Name in Passport" />

                        <Label Text="WhatsApp:" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                        <Entry Text="{Binding WhatsApp}" Placeholder="+972..." Keyboard="Telephone" />

                        <Label Text="אימייל:" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                        <Entry Text="{Binding Email}" Placeholder="email@example.com" Keyboard="Email" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Section 2: Dietary & Altitude Health Notes -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="העדפות תזונה ובריאות" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding DietaryPreferences, StringFormat='כשרות/תזונה: {0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" IsVisible="{Binding DietaryPreferences, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding MedicalNotes, StringFormat='הערות רפואיות: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" IsVisible="{Binding MedicalNotes, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding InsuranceCompany, StringFormat='ביטוח: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" IsVisible="{Binding InsuranceCompany, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Save Changes Button (in Edit Mode) -->
            <Button Text="💾 שמור שינויים"
                    Command="{Binding SaveProfileCommand}"
                    IsVisible="{Binding IsEditing}"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <!-- Logout Button -->
            <Button Text="התנתק מהחשבון 🚪"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
