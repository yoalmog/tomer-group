<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
             x:Class="TomerGroup.Mobile.Pages.Customer.ProfilePage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,12,16,36">

            <!-- ============================================================ -->
            <!-- 1. UNAUTHENTICATED PROFILE GATEWAY                           -->
            <!-- ============================================================ -->
            <VerticalStackLayout Spacing="18" IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}">
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Border StrokeThickness="0" WidthRequest="72" HeightRequest="72" BackgroundColor="Transparent" HorizontalOptions="Center">
                            <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="72" HeightRequest="72" />
                        </Border>

                        <Label Text="{Binding GatewayTitle}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                        <Label Text="{Binding GatewayDescription}"
                               FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" LineHeight="1.3" />

                        <!-- Benefits List -->
                        <VerticalStackLayout Spacing="10" Margin="0,6,0,6">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✓" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding BenefitItinerary}" FontSize="13" TextColor="#334155" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✓" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding BenefitVouchers}" FontSize="13" TextColor="#334155" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✓" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding BenefitWallet}" FontSize="13" TextColor="#334155" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✓" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding BenefitPreferences}" FontSize="13" TextColor="#334155" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Button Text="{Binding LoginButtonText}"
                                Command="{Binding OpenSignInCommand}"
                                Style="{StaticResource BrandButtonStyle}"
                                WidthRequest="220"
                                HorizontalOptions="Center"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============================================================ -->
            <!-- 2. AUTHENTICATED PROFILE HEADER                              -->
            <!-- ============================================================ -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsAuthenticated}">

                <!-- Customer Avatar & Name Card -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White" Padding="20">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <!-- Initials Circle -->
                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 30" StrokeThickness="0" WidthRequest="60" HeightRequest="60" VerticalOptions="Center">
                            <Label Text="{Binding Initials}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding HebrewName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                            <Label Text="{Binding Email}" FontSize="13" TextColor="#64748B" />
                            <Label Text="{Binding Phone}" FontSize="12" TextColor="#94A3B8" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="{Binding IsEditing, Converter={StaticResource BoolToEditIconConverter}}"
                                Command="{Binding ToggleEditModeCommand}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                CornerRadius="16"
                                HeightRequest="36"
                                WidthRequest="44"
                                FontSize="14"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- TRAVEL MANAGEMENT QUICK ACTIONS (Trips, Bookings, Docs)      -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding QuickLinksTitle}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <!-- My Trips -->
                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12,14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🗺️" FontSize="20" />
                                    <Label Text="{Binding MyTripsLinkText}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenMyTripsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Bookings -->
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12,14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🎫" FontSize="20" />
                                    <Label Text="{Binding BookingsLinkText}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenBookingsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Documents -->
                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12,14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="📁" FontSize="20" />
                                    <Label Text="{Binding DocumentsLinkText}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDocumentsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Notifications -->
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12,14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🔔" FontSize="20" />
                                    <Label Text="{Binding NotificationsLinkText}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Status / Alert message -->
                <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        BackgroundColor="#ECFDF5" Stroke="#A7F3D0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                    <Label Text="{Binding StatusMessage}" TextColor="#065F46" FontSize="12" FontAttributes="Bold" />
                </Border>

                <!-- ============================================================ -->
                <!-- TRAVEL PREFERENCES & KOSHER / DIETARY                         -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding DietarySectionTitle}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                        <!-- Read Mode -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{Binding DietaryPreferences}" FontSize="14" TextColor="#0F172A" FontAttributes="Bold"
                                   IsVisible="{Binding DietaryPreferences, Converter={StaticResource StringNotEmptyConverter}}" />
                            <Label Text="{Binding NoDietaryPreferencesText}" FontSize="13" TextColor="#94A3B8"
                                   IsVisible="{Binding DietaryPreferences, Converter={StaticResource StringEmptyConverter}}" />
                        </VerticalStackLayout>

                        <!-- Edit Mode Picker -->
                        <Picker Title="{Binding DietaryPickerTitle}"
                                ItemsSource="{Binding DietaryOptions}"
                                SelectedItem="{Binding SelectedDietaryOption}"
                                TextColor="#0F172A"
                                BackgroundColor="#F8FAFC"
                                IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================================ -->
                <!-- PASSPORT & SENSITIVE DETAILS (Secure Toggle)                 -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding PassportSectionTitle}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="{Binding PassportRevealButtonText}"
                                    Command="{Binding ToggleRevealPassportCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F172A"
                                    CornerRadius="14"
                                    HeightRequest="32"
                                    FontSize="11"
                                    Padding="10,0" />
                        </Grid>

                        <Label Text="{Binding DisplayPassportNumber}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding PassportNoticeText}" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================================ -->
                <!-- EMERGENCY CONTACT DETAILS                                    -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding EmergencySectionTitle}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}">
                            <VerticalStackLayout>
                                <Label Text="{Binding ContactNameLabel}" FontSize="11" TextColor="#64748B" />
                                <Label Text="{Binding EmergencyContactName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding EmergencyPhoneLabel}" FontSize="11" TextColor="#64748B" />
                                <Label Text="{Binding EmergencyContactPhone}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Edit Mode -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing}">
                            <Entry Placeholder="{Binding ContactNamePlaceholder}" Text="{Binding EmergencyContactName}" TextColor="#0F172A" BackgroundColor="#F8FAFC" />
                            <Entry Placeholder="{Binding EmergencyPhonePlaceholder}" Text="{Binding EmergencyContactPhone}" TextColor="#0F172A" BackgroundColor="#F8FAFC" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Save Button in Edit Mode -->
                <Button Text="{Binding SaveProfileButtonText}"
                        Command="{Binding SaveProfileCommand}"
                        IsVisible="{Binding IsEditing}"
                        Style="{StaticResource BrandButtonStyle}"
                        Margin="0,4,0,0" />

            </VerticalStackLayout>

            <!-- ============================================================ -->
            <!-- 3. SHARED SETTINGS: LANGUAGE & AGENCY CONTACT                -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LanguageSectionTitle}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="עברית" Command="{Binding ChangeLanguageCommand}" CommandParameter="he"
                                BackgroundColor="{Binding HebrewButtonBg}" TextColor="{Binding HebrewButtonText}"
                                FontAttributes="{Binding HebrewFontWeight}" CornerRadius="16" HeightRequest="38" FontSize="12" />
                        <Button Grid.Column="1" Text="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                                BackgroundColor="{Binding EnglishButtonBg}" TextColor="{Binding EnglishButtonText}"
                                FontAttributes="{Binding EnglishFontWeight}" CornerRadius="16" HeightRequest="38" FontSize="12" />
                        <Button Grid.Column="2" Text="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"
                                BackgroundColor="{Binding SpanishButtonBg}" TextColor="{Binding SpanishButtonText}"
                                FontAttributes="{Binding SpanishFontWeight}" CornerRadius="16" HeightRequest="38" FontSize="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Support Hotline Card -->
            <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="💬" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding SupportTitle}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding SupportSubtitle}" FontSize="11" TextColor="#CBD5E1" />
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenWhatsAppCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Log Out Button (Authenticated Only - Returns smoothly to Public Home) -->
            <Button Text="{Binding LogoutButtonText}"
                    Command="{Binding LogoutCommand}"
                    IsVisible="{Binding IsAuthenticated}"
                    BackgroundColor="#FEE2E2"
                    TextColor="#DC2626"
                    CornerRadius="22"
                    HeightRequest="44"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
