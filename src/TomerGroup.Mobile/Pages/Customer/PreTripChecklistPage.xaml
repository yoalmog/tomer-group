<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.PreTripChecklistPage"
             x:DataType="vm:PreTripChecklistViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding EyebrowText}" FontSize="12" FontAttributes="Bold" TextColor="#FDE68A"/>
                    <Label Text="{Binding HeroTitle}" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="{Binding HeroSubtitle}" FontSize="13" TextColor="#E2E8F0"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding SectionTitle}" Style="{StaticResource SectionTitleStyle}"/>

                    <Border Padding="12" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding PassportTitle}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding PassportSubtitle}" FontSize="12" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <CheckBox IsChecked="{Binding PassportReady}" Color="#0F172A"/>
                        </Grid>
                    </Border>

                    <Border Padding="12" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding InsuranceTitle}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding InsuranceSubtitle}" FontSize="12" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <CheckBox IsChecked="{Binding InsuranceReady}" Color="#0F172A"/>
                        </Grid>
                    </Border>

                    <Border Padding="12" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding FlightTitle}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding FlightSubtitle}" FontSize="12" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <CheckBox IsChecked="{Binding FlightConfirmationReady}" Color="#0F172A"/>
                        </Grid>
                    </Border>

                    <Border Padding="12" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding HotelTitle}" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="{Binding HotelSubtitle}" FontSize="12" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <CheckBox IsChecked="{Binding HotelVouchersReady}" Color="#0F172A"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#F0FDF4" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Status" FontSize="12" FontAttributes="Bold" TextColor="#15803D"/>
                            <Label Text="{Binding StatusMessage}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="{Binding SummaryButtonText}"
                            Command="{Binding OpenTripSummaryCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
