<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
              x:Class="TomerGroup.Mobile.Pages.Customer.DocumentsPage"
              Title="המסמכים והאישורים שלי">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Digital Wallet Hero Banner -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🎫" FontSize="22" VerticalOptions="Center" />
                        <Label Text="ארנק מסמכים ואישורים דיגיטלי" TextColor="White" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="אישורי מאצ'ו פיצ'ו, שוברי רכבות, מלונות ופוליסות ביטוח זמינים במכשירך גם ללא חיבור לאינטרנט בהרי האנדים."
                           TextColor="#CBD5E1" FontSize="12" LineBreakMode="WordWrap" />
                    <Border BackgroundColor="#10B981" StrokeShape="RoundRectangle 6" Padding="8,4" HorizontalOptions="Start" Margin="0,4,0,0">
                        <Label Text="✓ זמין לצפייה אופליין במסלול" TextColor="White" FontSize="11" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Notification / Status message -->
            <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#E0F2FE" StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding StatusMessage}" TextColor="#0369A1" FontSize="13" FontAttributes="Bold" />
            </Border>

            <!-- Category Filter Tabs -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasDocuments}">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="הכל" Command="{Binding FilterByCategoryCommand}" CommandParameter="הכל"
                            Style="{StaticResource PrimaryButtonStyle}" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                    <Button Text="אישורי כניסה וטרקים" Command="{Binding FilterByCategoryCommand}" CommandParameter="אישורים"
                            BackgroundColor="#E2E8F0" TextColor="{StaticResource PrimaryDark}" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                    <Button Text="שוברי שירות ומלונות" Command="{Binding FilterByCategoryCommand}" CommandParameter="שוברים"
                            BackgroundColor="#E2E8F0" TextColor="{StaticResource PrimaryDark}" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                    <Button Text="מסמכים אישיים וביטוח" Command="{Binding FilterByCategoryCommand}" CommandParameter="אישי"
                            BackgroundColor="#E2E8F0" TextColor="{StaticResource PrimaryDark}" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Professional Empty State (Visible when HasDocuments is False) -->
            <Border Style="{StaticResource EmptyStateCardStyle}" IsVisible="{Binding HasDocuments, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="📄" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding EmptyTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyDescription}" FontSize="13" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button Text="צור קשר עם הסוכנות 💬"
                            Command="{Binding ContactAgencyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="20,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Document List (Visible when HasDocuments is True) -->
            <CollectionView ItemsSource="{Binding FilteredDocuments}" IsVisible="{Binding HasDocuments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrameStyle}" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource PrimaryLight}" StrokeShape="RoundRectangle 8" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                        <Label Text="📄" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding HebrewName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark=White}" />
                                        <Label Text="{Binding Name}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                                        <Label Text="{Binding Circuit, StringFormat='מסלול: {0}'}" FontSize="12" TextColor="{StaticResource Secondary}"
                                               IsVisible="{Binding Circuit, Converter={StaticResource StringNotEmptyConverter}}" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Start">
                                        <Label Text="{Binding FileExtension, StringFormat='.{0}'}" TextColor="{StaticResource PrimaryDark}" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <!-- Passport Match Indicator -->
                                <Border BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="8,4"
                                        IsVisible="{Binding PermitPassportNumber, Converter={StaticResource StringNotEmptyConverter}}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🛂" FontSize="13" VerticalOptions="Center" />
                                        <Label Text="{Binding PermitPassportNumber, StringFormat='מותאם לדרכון: {0}'}"
                                               TextColor="#92400E" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Actions Grid -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="הורד / פתח ⬇️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DownloadDocumentCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Primary}" TextColor="White" HeightRequest="38" FontSize="12" CornerRadius="8" />
                                    <Button Grid.Column="1" Text="שתף בווטסאפ 📲"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ShareDocumentCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#25D366" TextColor="White" HeightRequest="38" FontSize="12" CornerRadius="8" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
