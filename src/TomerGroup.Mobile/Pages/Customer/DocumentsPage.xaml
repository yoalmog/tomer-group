<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.DocumentsPage"
             Title="{Binding PageTitle}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,12,16,32">

            <!-- ============================================================ -->
            <!-- 1. CONTEXTUAL AUTHENTICATION GATEWAY (Unauthenticated)        -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardFrameStyle}"
                    IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="White"
                    Padding="24">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Border StrokeThickness="0" WidthRequest="64" HeightRequest="64" BackgroundColor="Transparent" HorizontalOptions="Center">
                        <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="64" HeightRequest="64" />
                    </Border>

                    <Label Text="{Binding GatewayTitle}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                    <Label Text="{Binding GatewayDescription}"
                           FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" LineHeight="1.3" />

                    <Button Text="{Binding SignInButtonText}"
                            Command="{Binding OpenSignInCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            WidthRequest="220"
                            HorizontalOptions="Center" />

                    <Button Text="{Binding ContinueExploringText}"
                            Command="{Binding ContinueExploringCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. EMPTY STATE (Authenticated but No Documents Yet)         -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource EmptyStateCardStyle}"
                    IsVisible="{Binding HasDocuments, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="White">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center"
                                     IsVisible="{Binding IsAuthenticated}">
                    <Border BackgroundColor="{StaticResource TomerRoseTint}" StrokeShape="RoundRectangle 32" StrokeThickness="0" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="🎫" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding EmptyTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyDescription}" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" LineHeight="1.3" />

                    <Button Text="{Binding ContactAgencyText}"
                            Command="{Binding ContactAgencyCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="20,0"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================ -->
            <!-- 3. AUTHENTICATED: DIGITAL WALLET HERO BANNER                 -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardFrameStyle}"
                    IsVisible="{Binding HasDocuments}"
                    BackgroundColor="{StaticResource Secondary}"
                    Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding WalletBannerTitle}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding WalletBannerSubtitle}" FontSize="11" TextColor="#94A3B8" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1" BackgroundColor="#10B981" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" VerticalOptions="Center">
                            <Label Text="{Binding OfflineAvailableBadge}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Status Alert if active -->
            <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#ECFDF5" Stroke="#A7F3D0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12,10">
                <Label Text="{Binding StatusMessage}" TextColor="#065F46" FontSize="12" FontAttributes="Bold" />
            </Border>

            <!-- ============================================================ -->
            <!-- 4. CATEGORY FILTER CHIPS                                     -->
            <!-- ============================================================ -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasDocuments}">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding FilterAllText}" Command="{Binding FilterByCategoryCommand}" CommandParameter="הכל"
                            BackgroundColor="{StaticResource Secondary}" TextColor="White" CornerRadius="18" HeightRequest="36" FontSize="12" FontAttributes="Bold" Padding="14,0" />
                    <Button Text="{Binding FilterPermitsText}" Command="{Binding FilterByCategoryCommand}" CommandParameter="אישורים"
                            BackgroundColor="#FFFFFF" TextColor="#334155" BorderColor="#CBD5E1" BorderWidth="1" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                    <Button Text="{Binding FilterVouchersText}" Command="{Binding FilterByCategoryCommand}" CommandParameter="שוברים"
                            BackgroundColor="#FFFFFF" TextColor="#334155" BorderColor="#CBD5E1" BorderWidth="1" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                    <Button Text="{Binding FilterPersonalText}" Command="{Binding FilterByCategoryCommand}" CommandParameter="אישי"
                            BackgroundColor="#FFFFFF" TextColor="#334155" BorderColor="#CBD5E1" BorderWidth="1" CornerRadius="18" HeightRequest="36" FontSize="12" Padding="14,0" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============================================================ -->
            <!-- 5. DOCUMENTS LIST                                            -->
            <!-- ============================================================ -->
            <CollectionView ItemsSource="{Binding FilteredDocuments}" IsVisible="{Binding HasDocuments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrameStyle}" Margin="0,0,0,12" BackgroundColor="White">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource TomerRoseTint}" StrokeShape="RoundRectangle 12" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                        <Label Text="📄" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                        <Label Text="{Binding DisplaySecondaryName}" FontSize="12" TextColor="#64748B"
                                               IsVisible="{Binding DisplaySecondaryName, Converter={StaticResource StringNotEmptyConverter}}" />
                                        <Label Text="{Binding Circuit}" FontSize="11" TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding Circuit, Converter={StaticResource StringNotEmptyConverter}}" FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,4" VerticalOptions="Start">
                                        <Label Text="{Binding FileExtension, StringFormat='.{0}'}" TextColor="{StaticResource Secondary}" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <!-- Passport Match Indicator -->
                                <Border BackgroundColor="#FEF3C7" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,4"
                                        IsVisible="{Binding PermitPassportNumber, Converter={StaticResource StringNotEmptyConverter}}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🛂" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding PermitPassportNumber}"
                                               TextColor="#92400E" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DownloadButtonText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DownloadDocumentCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BrandButtonStyle}" HeightRequest="38" FontSize="12" CornerRadius="19" />

                                    <Button Grid.Column="1" Text="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ShareWhatsAppText}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ShareDocumentCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#25D366" TextColor="White" HeightRequest="38" FontSize="12" FontAttributes="Bold" CornerRadius="19" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
