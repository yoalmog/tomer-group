<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TomerGroup.Mobile.Pages.Customer.TripSummaryPage"
             Title="Trip summary">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Curated itinerary" FontSize="12" FontAttributes="Bold" TextColor="#FDE68A"/>
                    <Label Text="{Binding Destination}" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Luxury Peru experience • 3-day journey" FontSize="13" TextColor="#E2E8F0"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Day-by-day overview" Style="{StaticResource SectionTitleStyle}"/>

                    <CollectionView ItemsSource="{Binding ItineraryDays}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" Margin="0,0,0,10" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding DayNumber, StringFormat='Day {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                                        <CollectionView ItemsSource="{Binding Highlights}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,4" Margin="0,2">
                                                        <Label Text="•  {Binding}" FontSize="13" TextColor="#475569"/>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
