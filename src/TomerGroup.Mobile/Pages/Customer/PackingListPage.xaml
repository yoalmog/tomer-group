<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.PackingListPage"
             x:DataType="vm:PackingListViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="16, 12">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.05" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <Button Grid.Column="0"
                        Text="{Binding BackButtonText}"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#0F172A"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="36"
                        Padding="0" />

                <Label Grid.Column="1"
                       Text="{Binding PageTitle}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalOptions="Center" />

                <Image Grid.Column="2"
                       Source="tomer_group_logo.png"
                       HeightRequest="28"
                       WidthRequest="28"
                       Aspect="AspectFit" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16, 16, 16, 32">

                <!-- Progress Card -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#FFFFFF"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding ProgressTitle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="1"
                                   Text="{Binding ProgressText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Grid>

                        <ProgressBar Progress="{Binding ProgressValue}"
                                     ProgressColor="{StaticResource Primary}"
                                     HeightRequest="6" />

                        <Label Text="{Binding ProTipText}"
                               FontSize="11"
                               TextColor="#64748B"
                               Margin="0, 4, 0, 0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Add Custom Item Input -->
                <Border StrokeThickness="1"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FFFFFF"
                        Padding="12, 4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0"
                               Text="{Binding NewItemName, Mode=TwoWay}"
                               Placeholder="{Binding AddCustomPlaceholder}"
                               FontSize="13"
                               TextColor="{StaticResource Secondary}"
                               PlaceholderColor="#94A3B8"
                               VerticalOptions="Center"
                               ReturnCommand="{Binding AddCustomItemCommand}" />

                        <Button Grid.Column="1"
                                Text="{Binding AddButtonText}"
                                Command="{Binding AddCustomItemCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="#FFFFFF"
                                CornerRadius="10"
                                FontSize="12"
                                HeightRequest="34"
                                Padding="12, 0" />
                    </Grid>
                </Border>

                <!-- Checklist Section -->
                <CollectionView ItemsSource="{Binding PackingItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackingChecklistItem">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#FFFFFF"
                                    Padding="14, 10"
                                    Margin="0, 3">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Color="{StaticResource Primary}"
                                              VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="8, 0">
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="#F1F5F9"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8, 2"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Category}"
                                               FontSize="10"
                                               TextColor="#475569"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

