<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
              x:Class="TomerGroup.Mobile.Pages.Customer.MyTripPage"
              Title="מסלול הטיול שלי">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Active Trip Overview Banner (Visible when HasTrip is True) -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="{StaticResource PrimaryDark}" IsVisible="{Binding HasTrip}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding CurrentTrip.TripCode}" FontSize="12" TextColor="{StaticResource SecondaryLight}" FontAttributes="Bold" />
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Secondary}" Padding="8,2" StrokeShape="RoundRectangle 6">
                            <Label Text="{Binding CurrentTrip.Status}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding CurrentTrip.Title}" FontSize="19" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding CurrentTrip.CustomerName}" FontSize="13" TextColor="#CBD5E1" IsVisible="{Binding CurrentTrip.CustomerName, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding CurrentTrip.StartDate, StringFormat='תאריכים: {0:dd.MM.yyyy}'}" FontSize="12" TextColor="{StaticResource SecondaryLight}" />
                </VerticalStackLayout>
            </Border>

            <!-- Professional Empty State (Visible when HasTrip is False) -->
            <Border Style="{StaticResource EmptyStateCardStyle}" IsVisible="{Binding HasTrip, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="🗺️" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding EmptyTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyDescription}" FontSize="13" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button Text="צור קשר עם הסוכנות 💬"
                            Command="{Binding OpenContactCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="20,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Interactive Day-by-Day Timeline List (Visible when HasTrip is True) -->
            <CollectionView ItemsSource="{Binding Days}" IsVisible="{Binding HasTrip}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrameStyle}" Margin="0,0,0,14">
                            <VerticalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="10">
                                    <Border BackgroundColor="{StaticResource Secondary}" Padding="8,4" StrokeShape="RoundRectangle 6">
                                        <Label Text="{Binding DayNumber, StringFormat='יום {0}'}" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <CollectionView ItemsSource="{Binding Activities}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,3" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}">
                                                <Grid ColumnDefinitions="55,*" RowSpacing="4">
                                                    <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Secondary}" VerticalOptions="Start" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                                        <Label Text="{Binding Location}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" IsVisible="{Binding Location, Converter={StaticResource StringNotEmptyConverter}}" />
                                                        <Label Text="{Binding GuideName, StringFormat='מדריך: {0}'}" FontSize="11" TextColor="{StaticResource PrimaryLight}" IsVisible="{Binding GuideName, Converter={StaticResource StringNotEmptyConverter}}" />
                                                        <Label Text="{Binding DriverName, StringFormat='נהג: {0}'}" FontSize="11" TextColor="{StaticResource PrimaryLight}" IsVisible="{Binding DriverName, Converter={StaticResource StringNotEmptyConverter}}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
