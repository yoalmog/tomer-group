<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Customer"
             x:Class="TomerGroup.Mobile.Pages.Customer.BookingsPage"
             Title="{Binding PageTitle}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,12,16,32">

            <!-- ============================================================ -->
            <!-- 1. CONTEXTUAL AUTHENTICATION GATEWAY (Unauthenticated)        -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardFrameStyle}"
                    IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="White"
                    Padding="24">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Border StrokeThickness="0" WidthRequest="64" HeightRequest="64" BackgroundColor="Transparent" HorizontalOptions="Center">
                        <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="64" HeightRequest="64" />
                    </Border>

                    <Label Text="{Binding GatewayTitle}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                    <Label Text="{Binding GatewayDescription}"
                           FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" LineHeight="1.3" />

                    <Button Text="{Binding SignInButtonText}"
                            Command="{Binding OpenSignInCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            WidthRequest="220"
                            HorizontalOptions="Center" />

                    <Button Text="{Binding ContinueExploringText}"
                            Command="{Binding ContinueExploringCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================ -->
            <!-- 2. EMPTY STATE (Authenticated but No Bookings Yet)          -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource EmptyStateCardStyle}"
                    IsVisible="{Binding HasBookings, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="White">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center"
                                     IsVisible="{Binding IsAuthenticated}">
                    <Border BackgroundColor="#FFF1F2" StrokeShape="RoundRectangle 32" StrokeThickness="0" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Label Text="📋" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding EmptyTitle}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyDescription}" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" LineHeight="1.3" />

                    <Button Text="{Binding ContactAgencyText}"
                            Command="{Binding ContactAgencyCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="20,0"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================================ -->
            <!-- 3. AUTHENTICATED: SUMMARY BANNER                             -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardFrameStyle}"
                    IsVisible="{Binding HasBookings}"
                    BackgroundColor="{StaticResource Secondary}"
                    Padding="18">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding SummaryBannerStatus}" FontSize="12" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                        <Label Text="{Binding SummaryBannerTitle}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding SummaryBannerSubtitle}" FontSize="11" TextColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" BackgroundColor="#10B981" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4" VerticalOptions="Center">
                        <Label Text="{Binding ConfirmedBadgeText}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- 4. RICH BOOKING CARDS LIST                                   -->
            <!-- ============================================================ -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasBookings}">
                <Label Text="{Binding ServicesSectionTitle}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />

                <CollectionView ItemsSource="{Binding DisplayCards}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TravelCardStyle}" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="0">
                                    <!-- Photo Header with Type & Status Badges -->
                                    <Grid HeightRequest="150">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="150" />
                                        <BoxView Color="#4D000000" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                        <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Spacing="6">
                                            <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3">
                                                <Label Text="{Binding BookingType}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Border BackgroundColor="#10B981" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="8,3" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                                            <Label Text="{Binding Status}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                        </Border>

                                        <VerticalStackLayout VerticalOptions="End" Margin="14" Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#F1F5F9" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Bottom Info Bar -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="14,12" BackgroundColor="White">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding DateFormatted}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
                                            <Label Text="{Binding ConfirmationCode}" FontSize="11" TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingsViewModel}}, Path=DetailsAndVoucherButtonText}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingsViewModel}}, Path=OpenBookingDetailCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource BrandButtonStyle}"
                                                HeightRequest="38"
                                                FontSize="12"
                                                Padding="14,0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
