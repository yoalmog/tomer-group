<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
             x:Class="TomerGroup.Mobile.Pages.SplashPage"
             BackgroundColor="#000000">

    <Grid IgnoreSafeArea="True">
        <!-- 1. Layer: Solid Black Canvas & Static Branded Fallback -->
        <BoxView BackgroundColor="#000000" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- 2. Layer: Hardware-Accelerated Cinematic Video View -->
        <WebView x:Name="VideoWebView"
                 IsVisible="{Binding IsVideoAvailable}"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 InputTransparent="True" />

        <!-- 3. Layer: Cinematic Radial Vignette & Contrast Overlay -->
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" Radius="0.85">
                    <GradientStop Color="#40000000" Offset="0.0" />
                    <GradientStop Color="#90000000" Offset="0.6" />
                    <GradientStop Color="#F0000000" Offset="1.0" />
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Top & Bottom Edge Gradient Dimming -->
        <BoxView VerticalOptions="Start" HeightRequest="160" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DD000000" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView VerticalOptions="End" HeightRequest="180" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#EE000000" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- 4. Layer: Official Tomer Group Logo & Typography Overlay -->
        <Grid x:Name="OverlayContainer"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="20"
              Padding="32">

            <!-- Official Tomer Group Logo with AspectFit -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    WidthRequest="180"
                    HeightRequest="180"
                    HorizontalOptions="Center"
                    BackgroundColor="Transparent">
                <Image Source="tomer_group_logo.png"
                       Aspect="AspectFit"
                       WidthRequest="180"
                       HeightRequest="180"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Row="1" Spacing="6" HorizontalOptions="Center">
                <Label Text="TOMER GROUP"
                       TextColor="White"
                       FontSize="28"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center" />
                <Label Text="{Binding Tagline}"
                       TextColor="#E11D68"
                       FontSize="13"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ActivityIndicator Grid.Row="2"
                               IsRunning="{Binding IsBusy}"
                               Color="#BC225E"
                               WidthRequest="36"
                               HeightRequest="36"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
