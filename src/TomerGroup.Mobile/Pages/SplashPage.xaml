<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
              x:Class="TomerGroup.Mobile.Pages.SplashPage"
              BackgroundColor="#0F172A">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" RowDefinitions="Auto,Auto,Auto" RowSpacing="24" Padding="32">
        <!-- Official Tomer Group Logo with AspectFit -->
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="180" HeightRequest="180" HorizontalOptions="Center" BackgroundColor="Transparent">
            <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="180" HeightRequest="180" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="6" HorizontalOptions="Center">
            <Label Text="TOMER GROUP"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   CharacterSpacing="1.5"
                   HorizontalOptions="Center" />
            <Label Text="PERU TRAVEL EXPERIENCE"
                   TextColor="#C28251"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           Color="#E11D48"
                           WidthRequest="36"
                           HeightRequest="36"
                           HorizontalOptions="Center" />
    </Grid>

</ContentPage>
