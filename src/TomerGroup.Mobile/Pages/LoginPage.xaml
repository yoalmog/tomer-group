<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
              x:Class="TomerGroup.Mobile.Pages.LoginPage"
              Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24" VerticalOptions="Center">

            <!-- Official Tomer Group Logo & Brand Header -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" BackgroundColor="Transparent">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" />
                </Border>
                <Label Text="TOMER GROUP"
                       FontSize="24"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}"
                       HorizontalOptions="Center" />
                <Label Text="PERU TRAVEL EXPERIENCE"
                       FontSize="13"
                       TextColor="{StaticResource Secondary}"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Language Switcher Pills -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="עברית" Command="{Binding ChangeLanguageCommand}" CommandParameter="he" HeightRequest="36" FontSize="13" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="18" Padding="14,0" />
                <Button Text="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en" HeightRequest="36" FontSize="13" BackgroundColor="#E2E8F0" TextColor="#0F172A" CornerRadius="18" Padding="14,0" />
                <Button Text="Español" Command="{Binding ChangeLanguageCommand}" CommandParameter="es" HeightRequest="36" FontSize="13" BackgroundColor="#E2E8F0" TextColor="#0F172A" CornerRadius="18" Padding="14,0" />
            </HorizontalStackLayout>

            <!-- Email / Password Login Card -->
            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="כניסה לחשבון / Sign In" Style="{StaticResource SectionTitleStyle}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="דואר אלקטרוני / Email:" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                        <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="traveler@example.com" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="סיסמה / Password:" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryLight}" />
                        <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 8" Padding="10,2">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Forgot Password Link -->
                    <Button Text="שכחת סיסמה? / Forgot Password?"
                            Command="{Binding OpenForgotPasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Accent}"
                            FontSize="13"
                            HorizontalOptions="End"
                            Padding="0" />

                    <!-- Primary Login Action -->
                    <Button Text="התחברות למערכת"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <!-- Status & Error Feedback -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
            </Border>

            <Border IsVisible="{Binding StatusInfo, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding StatusInfo}" TextColor="#059669" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
            </Border>

            <!-- Footer Assistance -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,10,0,0">
                <Label Text="זקוק לעזרה? צוות Tomer Group זמין 24/7" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" />
                <Label Text="+51 984 999 888 🇵🇪 | Calle San Agustín 415, Cusco" FontSize="11" TextColor="{StaticResource Secondary}" FontAttributes="Bold" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
