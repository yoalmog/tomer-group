<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TomerGroup.Mobile.Pages.LoginPage"
             Title="{Binding Title}"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20,16,20,32">

            <!-- Top Bar with Back Button and Language Switcher -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button Grid.Column="0" Text="{Binding BackToExploreText}"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        HeightRequest="36"
                        FontSize="12"
                        FontAttributes="Bold"
                        Padding="14,0" />

                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                    <Button Text="עב" Command="{Binding ChangeLanguageCommand}" CommandParameter="he"
                            BackgroundColor="{Binding HebrewButtonBg}" TextColor="{Binding HebrewButtonText}"
                            FontAttributes="{Binding HebrewFontWeight}" HeightRequest="32" WidthRequest="36" FontSize="11" CornerRadius="8" Padding="0" />
                    <Button Text="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                            BackgroundColor="{Binding EnglishButtonBg}" TextColor="{Binding EnglishButtonText}"
                            FontAttributes="{Binding EnglishFontWeight}" HeightRequest="32" WidthRequest="36" FontSize="11" CornerRadius="8" Padding="0" />
                    <Button Text="ES" Command="{Binding ChangeLanguageCommand}" CommandParameter="es"
                            BackgroundColor="{Binding SpanishButtonBg}" TextColor="{Binding SpanishButtonText}"
                            FontAttributes="{Binding SpanishFontWeight}" HeightRequest="32" WidthRequest="36" FontSize="11" CornerRadius="8" Padding="0" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Brand Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,4">
                <Border StrokeThickness="0" WidthRequest="60" HeightRequest="60" BackgroundColor="Transparent" HorizontalOptions="Center">
                    <Image Source="tomer_group_logo.png" Aspect="AspectFit" WidthRequest="60" HeightRequest="60" />
                </Border>
                <Label Text="Tomer Group" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                <Label Text="Peru Travel Experience" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" CharacterSpacing="1.5" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Login Method Toggle (Email / Phone) -->
            <Grid ColumnDefinitions="*,*" BackgroundColor="#E2E8F0" HeightRequest="44" Margin="0,4,0,4">
                <Button Grid.Column="0" Text="{Binding EmailTabTitle}"
                        Command="{Binding ToggleLoginMethodCommand}"
                        CommandParameter="Email"
                        BackgroundColor="{Binding IsPhoneLoginMode, Converter={StaticResource BoolToTabBgConverter}}"
                        TextColor="{Binding IsPhoneLoginMode, Converter={StaticResource BoolToTabTextConverter}}"
                        CornerRadius="14" HeightRequest="38" FontSize="13" FontAttributes="Bold" Margin="3" />

                <Button Grid.Column="1" Text="{Binding PhoneTabTitle}"
                        Command="{Binding ToggleLoginMethodCommand}"
                        CommandParameter="Phone"
                        BackgroundColor="{Binding IsPhoneLoginMode, Converter={StaticResource InvertedBoolToTabBgConverter}}"
                        TextColor="{Binding IsPhoneLoginMode, Converter={StaticResource InvertedBoolToTabTextConverter}}"
                        CornerRadius="14" HeightRequest="38" FontSize="13" FontAttributes="Bold" Margin="3" />
            </Grid>

            <!-- Email & Password Form -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White" Padding="20"
                    IsVisible="{Binding IsPhoneLoginMode, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding PersonalAreaHeading}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding EmailFieldLabel}" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" Padding="12,2" BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="name@example.com" FontSize="14" BackgroundColor="Transparent" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding PasswordFieldLabel}" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" Padding="12,2" BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" FontSize="14" BackgroundColor="Transparent" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="{Binding ForgotPasswordButtonText}"
                            Command="{Binding OpenForgotPasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            Padding="0" />

                    <Button Text="{Binding SignInButtonText}"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource BrandButtonStyle}"
                            HeightRequest="48"
                            Margin="0,4,0,0" />

                    <Button Text="{Binding CreateAccountButtonText}"
                            Command="{Binding OpenRegisterCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Phone OTP Form -->
            <Border Style="{StaticResource CardFrameStyle}" BackgroundColor="White" Padding="20"
                    IsVisible="{Binding IsPhoneLoginMode}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding PhoneLoginHeading}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding PhoneFieldLabel}" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" Padding="12,2" BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Placeholder="+972 50 000 0000" FontSize="14" BackgroundColor="Transparent" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="{Binding SendCodeButtonText}"
                            Command="{Binding SendPhoneCodeCommand}"
                            IsVisible="{Binding IsCodeSent, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="44" />

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCodeSent}">
                        <Label Text="{Binding CodeFieldLabel}" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" Padding="12,2" BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding VerificationCode}" Keyboard="Numeric" Placeholder="123456" FontSize="16" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                        </Border>

                        <Button Text="{Binding VerifyCodeButtonText}"
                                Command="{Binding VerifyPhoneCodeCommand}"
                                Style="{StaticResource BrandButtonStyle}"
                                HeightRequest="46"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Error / Status Messages -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,8">
                <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
            </Border>

            <Border IsVisible="{Binding StatusInfo, Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#ECFDF5" Stroke="#A7F3D0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,8">
                <Label Text="{Binding StatusInfo}" TextColor="#065F46" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
            </Border>

            <!-- Continue Exploring as Guest Button -->
            <Button Text="{Binding ContinueAsGuestText}"
                    Command="{Binding ContinueAsGuestCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#64748B"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

            <!-- Support Hotline Info -->
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label Text="{Binding SupportFooterText}" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center" />
                <Label Text="+51 84 223 456 • Cusco, Peru" FontSize="11" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
