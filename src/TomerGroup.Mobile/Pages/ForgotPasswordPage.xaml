<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels"
             x:Class="TomerGroup.Mobile.Pages.ForgotPasswordPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24" VerticalOptions="Center">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="splash.png" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" />
                <Label Text="איפוס סיסמה"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" />
                <Label Text="Tomer Group Traveler Recovery"
                       FontSize="14"
                       TextColor="{StaticResource Secondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="14">

                    <!-- Step 1: Request Token -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsTokenSent, Converter={x:Null}}">
                        <Label Text="הזן את כתובת הדואר האלקטרוני שלך:" FontSize="13" FontAttributes="Bold" />
                        <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="danny@israel.com" />
                        <Button Text="שלח קוד איפוס" Command="{Binding RequestResetTokenCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </VerticalStackLayout>

                    <!-- Step 2: Enter Token & New Password -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsTokenSent}">
                        <Label Text="קוד איפוס / Reset Token:" FontSize="13" FontAttributes="Bold" />
                        <Entry Text="{Binding ResetToken}" Placeholder="Enter reset token" />

                        <Label Text="סיסמה חדשה / New Password:" FontSize="13" FontAttributes="Bold" />
                        <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="New password" />

                        <Label Text="אימות סיסמה / Confirm Password:" FontSize="13" FontAttributes="Bold" />
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Confirm password" />

                        <Button Text="החלף סיסמה והתחבר" Command="{Binding SubmitNewPasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </VerticalStackLayout>

                    <!-- Messages -->
                    <Label Text="{Binding InfoMessage}" TextColor="{StaticResource StatusSuccess}" FontSize="13" IsVisible="{Binding InfoMessage, Converter={x:Null}}" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusError}" FontSize="13" IsVisible="{Binding ErrorMessage, Converter={x:Null}}" />

                    <Button Text="חזרה להתחברות" Command="{Binding BackToLoginCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

