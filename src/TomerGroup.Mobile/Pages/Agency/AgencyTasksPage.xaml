<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Agency"
             xmlns:models="clr-namespace:TomerGroup.Core.Models;assembly=TomerGroup.Core"
             x:Class="TomerGroup.Mobile.Pages.Agency.AgencyTasksPage"
             x:DataType="vm:AgencyTasksViewModel"
             Title="משימות תפעול / Staff Tasks"
             BackgroundColor="#0F1015">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="16">

                <!-- Header Actions -->
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="פתוח" Command="{Binding SetStatusFilterCommand}" CommandParameter="Open" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="בביצוע" Command="{Binding SetStatusFilterCommand}" CommandParameter="InProgress" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="הושלם" Command="{Binding SetStatusFilterCommand}" CommandParameter="Completed" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="+ משימה חדשה" Command="{Binding OpenCreateModalCommand}" BackgroundColor="#BC225E" TextColor="White" HeightRequest="32" Padding="12,0" CornerRadius="6" FontSize="11" />
                </Grid>

                <!-- Tasks List -->
                <CollectionView ItemsSource="{Binding FilteredTasks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StaffTask">
                            <Border StrokeThickness="1" Stroke="#252A3A" BackgroundColor="#161922" Padding="14" Margin="0,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                        <Border Grid.Column="1" BackgroundColor="#374151" Padding="6,2">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                            <Label Text="{Binding Priority}" FontSize="10" FontAttributes="Bold" TextColor="#F59E0B" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Description}" FontSize="12" TextColor="#94A3B8" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding DueDate, StringFormat='יעד: {0:dd/MM/yyyy HH:mm}'}" FontSize="11" TextColor="#CBD5E1" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Button Text="התחל ⏳"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgencyTasksViewModel}}, Path=StartTaskCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#252A3A"
                                                    TextColor="#38BDF8"
                                                    HeightRequest="28"
                                                    FontSize="10"
                                                    Padding="8,0"
                                                    CornerRadius="4" />
                                            <Button Text="הושלם ✓"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgencyTasksViewModel}}, Path=CompleteTaskCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#059669"
                                                    TextColor="White"
                                                    HeightRequest="28"
                                                    FontSize="10"
                                                    Padding="8,0"
                                                    CornerRadius="4" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="אין משימות פתוחות" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" Margin="30" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Create Task Modal -->
        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsCreateModalOpen}" Padding="16">
            <Border BackgroundColor="#181B26" StrokeThickness="1" Stroke="#373D52" Padding="16" VerticalOptions="Center" MaximumWidthRequest="400">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="יצירת משימת תפעול / New Task" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    
                    <Label Text="כותרת המשימה:" FontSize="12" TextColor="#94A3B8" />
                    <Entry Text="{Binding NewTaskTitle}" Placeholder="לדוגמה: בדיקת דרכונים לכרטיסי רכבת" PlaceholderColor="#64748B" TextColor="White" BackgroundColor="#11131B" />

                    <Label Text="פירוט והוראות:" FontSize="12" TextColor="#94A3B8" />
                    <Editor Text="{Binding NewTaskDescription}" HeightRequest="60" TextColor="White" BackgroundColor="#11131B" />

                    <Label Text="תאריך ושעת יעד:" FontSize="12" TextColor="#94A3B8" />
                    <DatePicker Date="{Binding NewTaskDueDate}" TextColor="White" BackgroundColor="#11131B" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Text="ביטול" Command="{Binding CloseCreateModalCommand}" BackgroundColor="#2E3448" TextColor="#CBD5E1" HeightRequest="40" CornerRadius="6" />
                        <Button Grid.Column="1" Text="צור משימה" Command="{Binding CreateTaskCommand}" BackgroundColor="#BC225E" TextColor="White" HeightRequest="40" CornerRadius="6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
