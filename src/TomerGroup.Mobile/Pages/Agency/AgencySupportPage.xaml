<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TomerGroup.Mobile.ViewModels.Agency"
             xmlns:dtos="clr-namespace:TomerGroup.Core.DTOs;assembly=TomerGroup.Core"
             xmlns:models="clr-namespace:TomerGroup.Core.Models;assembly=TomerGroup.Core"
             x:Class="TomerGroup.Mobile.Pages.Agency.AgencySupportPage"
             x:DataType="vm:AgencySupportViewModel"
             Title="מוקד שירות ותמיכה / Support Center"
             BackgroundColor="#0F1015">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="16">

                <!-- Filter Chips -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="הכל" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="חדש" Command="{Binding SetStatusFilterCommand}" CommandParameter="New" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="פתוח" Command="{Binding SetStatusFilterCommand}" CommandParameter="Open" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="ממתין לצוות" Command="{Binding SetStatusFilterCommand}" CommandParameter="WaitingStaff" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="נפתר" Command="{Binding SetStatusFilterCommand}" CommandParameter="Resolved" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                        <Button Text="סגור" Command="{Binding SetStatusFilterCommand}" CommandParameter="Closed" BackgroundColor="#2A3045" TextColor="White" HeightRequest="32" Padding="10,0" CornerRadius="16" FontSize="11" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Tickets List -->
                <CollectionView ItemsSource="{Binding FilteredTickets}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:SupportTicketSummaryDto">
                            <Border StrokeThickness="1" Stroke="#252A3A" BackgroundColor="#161922" Padding="14" Margin="0,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AgencySupportViewModel}}, Path=OpenTicketDetailCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Subject}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                        <Border Grid.Column="1" BackgroundColor="#374151" Padding="6,2">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                            <Label Text="{Binding Priority}" FontSize="10" FontAttributes="Bold" TextColor="#F43F5E" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Category}" FontSize="12" TextColor="#A78BFA" />
                                            <Label Text="•" FontSize="12" TextColor="#64748B" />
                                            <Label Text="{Binding MessagesCount, StringFormat='{0} הודעות'}" FontSize="12" TextColor="#94A3B8" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="11" TextColor="#38BDF8" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="אין פניות שירות בקטגוריה זו" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" Margin="30" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Ticket Detail & Reply Modal -->
        <Grid BackgroundColor="#DD000000" IsVisible="{Binding IsDetailModalOpen}" Padding="16">
            <Border BackgroundColor="#181B26" StrokeThickness="1" Stroke="#373D52" Padding="16" VerticalOptions="Center" MaximumWidthRequest="450">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding CurrentTicket.Subject}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding CurrentTicket.Status, StringFormat='סטטוס: {0}'}" FontSize="11" TextColor="#38BDF8" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseDetailModalCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" FontSize="18" HeightRequest="30" />
                    </Grid>

                    <!-- Messages Thread -->
                    <CollectionView ItemsSource="{Binding TicketMessages}" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SupportTicketMessage">
                                <Border StrokeThickness="1" Stroke="#2D3345" BackgroundColor="{Binding IsInternalNote, Converter={x:Null}}" Padding="10,8" Margin="0,3">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding SenderName}" FontSize="11" FontAttributes="Bold" TextColor="#A78BFA" />
                                            <Label Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}" FontSize="10" TextColor="#64748B" />
                                        </Grid>
                                        <Label Text="{Binding MessageText}" FontSize="12" TextColor="White" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Reply Composer -->
                    <Editor Text="{Binding ReplyText}" Placeholder="כתוב מענה ללקוח או הערה פנימית..." PlaceholderColor="#64748B" TextColor="White" BackgroundColor="#10121A" HeightRequest="60" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsInternalNote}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="הערה פנימית (מוסתר מהלקוח)" FontSize="11" TextColor="#CBD5E1" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="שלח מענה ✉" Command="{Binding SendReplyCommand}" BackgroundColor="#BC225E" TextColor="White" HeightRequest="36" Padding="12,0" CornerRadius="6" />
                    </Grid>

                    <!-- Quick Status Change Buttons -->
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Button Text="סמן כנפתר ✓" Command="{Binding UpdateTicketStatusCommand}" CommandParameter="Resolved" BackgroundColor="#059669" TextColor="White" HeightRequest="28" FontSize="10" Padding="8,0" CornerRadius="4" />
                        <Button Text="סגור פנייה" Command="{Binding UpdateTicketStatusCommand}" CommandParameter="Closed" BackgroundColor="#374151" TextColor="White" HeightRequest="28" FontSize="10" Padding="8,0" CornerRadius="4" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
