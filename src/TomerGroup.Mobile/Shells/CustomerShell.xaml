<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TomerGroup.Mobile.Shells.CustomerShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customer="clr-namespace:TomerGroup.Mobile.Pages.Customer"
    Title="Tomer Group"
    BackgroundColor="#F8FAFC"
    ForegroundColor="#0F172A"
    NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#E11D48"
    Shell.TabBarTitleColor="#E11D48"
    Shell.TabBarUnselectedColor="#64748B"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <Tab Title="בית" Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate customer:CustomerHomePage}" Route="Home" />
        </Tab>
        <Tab Title="גלה" Icon="trip_icon.png">
            <ShellContent ContentTemplate="{DataTemplate customer:ExplorePage}" Route="Explore" />
        </Tab>
        <Tab Title="הטיול שלי" Icon="trip_icon.png">
            <ShellContent ContentTemplate="{DataTemplate customer:MyTripPage}" Route="MyTrip" />
        </Tab>
        <Tab Title="הזמנות" Icon="booking_icon.png">
            <ShellContent ContentTemplate="{DataTemplate customer:BookingsPage}" Route="Bookings" />
        </Tab>
        <Tab Title="פרופיל" Icon="profile_icon.png">
            <ShellContent ContentTemplate="{DataTemplate customer:ProfilePage}" Route="Profile" />
        </Tab>
    </TabBar>

</Shell>
