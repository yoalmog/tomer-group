<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(EnableMaui)' == 'true' and '$(TargetPlatform)' == 'ios'">net8.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMaui)' == 'true' and '$(TargetPlatform)' != 'ios'">net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMaui)' != 'true'">net8.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net8.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0'">Library</OutputType>
    <RootNamespace>TomerGroup.Mobile</RootNamespace>
    <UseMaui Condition="'$(TargetFramework)' != 'net8.0'">true</UseMaui>
    <SingleProject Condition="'$(TargetFramework)' != 'net8.0'">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <NoWarn>$(NoWarn);NETSDK1202;MA002</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>Tomer Group</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.tomergroup.travel</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.2</TargetPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">34.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidEnableProfiledAOT Condition="'$(Configuration)' == 'Release'">true</AndroidEnableProfiledAOT>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TomerGroup.Core\TomerGroup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseMaui)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.100" />
    <PackageReference Include="CommunityToolkit.Maui" Version="8.0.0" />

    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon.svg" Color="#1B365D" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B365D" BaseSize="128,128" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseMaui)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_MAUI</DefineConstants>
  </PropertyGroup>

  <!-- In non-MAUI CLI fallback builds, exclude XAML files and MauiProgram from MSBuild compilation while keeping all ViewModels, Services, and business logic compiled -->
  <ItemGroup Condition="'$(UseMaui)' != 'true'">
    <Compile Remove="**\*.xaml.cs" />
    <Compile Remove="MauiProgram.cs" />
    <Compile Remove="Converters\**" />
    <None Include="**\*.xaml.cs" />
    <None Include="**\*.xaml" />
    <None Include="MauiProgram.cs" />
  </ItemGroup>

</Project>

