<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ -->
    <!-- TOMER GROUP OFFICIAL BRAND DESIGN TOKENS                    -->
    <!-- Derived directly from official Tomer Group Magenta/Black ID   -->
    <!-- ============================================================ -->

    <!-- Primary Brand Colors: Official Logo Magenta / Rose -->
    <Color x:Key="TomerPrimary">#BC225E</Color>
    <Color x:Key="TomerPrimaryDark">#881337</Color>
    <Color x:Key="TomerPrimaryLight">#E11D68</Color>
    <Color x:Key="TomerAccent">#F43F7A</Color>
    <Color x:Key="TomerRoseTint">#FFF1F5</Color>
    <Color x:Key="TomerRoseDark">#881337</Color>

    <!-- Deep Luxury Black & Clean White from Logo -->
    <Color x:Key="TomerBlack">#0A0A0C</Color>
    <Color x:Key="TomerBlackDark">#000000</Color>
    <Color x:Key="TomerWhite">#FFFFFF</Color>

    <!-- Neutral Surfaces & Backgrounds -->
    <Color x:Key="TomerBackground">#FAF9FB</Color>
    <Color x:Key="TomerBackgroundDark">#000000</Color>
    <Color x:Key="TomerSurface">#FFFFFF</Color>
    <Color x:Key="TomerSurfaceDark">#121218</Color>
    <Color x:Key="TomerCard">#FFFFFF</Color>
    <Color x:Key="TomerCardDark">#181820</Color>

    <!-- Typography Tones -->
    <Color x:Key="TomerTextPrimary">#0A0A0C</Color>
    <Color x:Key="TomerTextSecondary">#71717A</Color>
    <Color x:Key="TomerTextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TomerTextSecondaryDark">#A1A1AA</Color>

    <!-- Structural Borders & Dividers -->
    <Color x:Key="TomerBorder">#F1E8EC</Color>
    <Color x:Key="TomerBorderDark">#2D2D3A</Color>

    <!-- Semantic Status Tones -->
    <Color x:Key="TomerSuccess">#10B981</Color>
    <Color x:Key="TomerSuccessBg">#ECFDF5</Color>
    <Color x:Key="TomerWarning">#F59E0B</Color>
    <Color x:Key="TomerWarningBg">#FFFBEB</Color>
    <Color x:Key="TomerError">#EF4444</Color>
    <Color x:Key="TomerErrorBg">#FEF2F2</Color>
    <Color x:Key="TomerInfo">#3B82F6</Color>
    <Color x:Key="TomerInfoBg">#EFF6FF</Color>

    <!-- ============================================================ -->
    <!-- BACKWARDS-COMPATIBLE ALIASES FOR SEAMLESS XAML RESOLUTION   -->
    <!-- ============================================================ -->
    <Color x:Key="Primary">#BC225E</Color>
    <Color x:Key="PrimaryDark">#881337</Color>
    <Color x:Key="PrimaryLight">#E11D68</Color>
    <Color x:Key="Secondary">#0A0A0C</Color>
    <Color x:Key="SecondaryDark">#000000</Color>
    <Color x:Key="SecondaryLight">#181820</Color>
    <Color x:Key="Accent">#F43F7A</Color>
    <Color x:Key="AccentLight">#FB7199</Color>
    <Color x:Key="BrandMonogram">#BC225E</Color>
    <Color x:Key="BrandMonogramLight">#E11D68</Color>

    <Color x:Key="BackgroundLight">#FAF9FB</Color>
    <Color x:Key="BackgroundDark">#000000</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#121218</Color>
    <Color x:Key="CardBorder">#F1E8EC</Color>
    <Color x:Key="CardBorderDark">#2D2D3A</Color>

    <Color x:Key="TextPrimaryLight">#0A0A0C</Color>
    <Color x:Key="TextSecondaryLight">#71717A</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryDark">#A1A1AA</Color>

    <Color x:Key="StatusSuccess">#10B981</Color>
    <Color x:Key="StatusSuccessBg">#ECFDF5</Color>
    <Color x:Key="StatusWarning">#F59E0B</Color>
    <Color x:Key="StatusWarningBg">#FFFBEB</Color>
    <Color x:Key="StatusError">#EF4444</Color>
    <Color x:Key="StatusErrorBg">#FEF2F2</Color>
    <Color x:Key="StatusInfo">#3B82F6</Color>
    <Color x:Key="StatusInfoBg">#EFF6FF</Color>

    <Color x:Key="BackgroundColor">#FAF9FB</Color>
    <Color x:Key="Background">#FAF9FB</Color>
    <Color x:Key="TextPrimary">#0A0A0C</Color>
    <Color x:Key="TextSecondary">#71717A</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

</ResourceDictionary>
